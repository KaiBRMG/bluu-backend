<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Applied to the Helper (Renderer/GPU/Plugin) binaries inside the bundle.
       They run the same V8 engine as the main process, so they need the same
       JIT allowances. Kept in step with entitlements.mac.plist. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- The microphone, for the Snipping Tool's narration.

       Under the Hardened Runtime this is what permits the process to open an
       audio input at all; it is the same key the App Sandbox uses, and it is
       required here even though this app is not sandboxed.

       It is only half of what macOS needs. `NSMicrophoneUsageDescription` in
       the Info.plist (see `mac.extendInfo` in package.json) is the other half,
       and its absence is not a refusal: TCC TERMINATES the process the
       moment the microphone is requested. Neither of these two may ship
       without the other.

       Keep every dash in this file single. XML forbids the sequence of two
       hyphens inside a comment, and Apple's parser reports it only as
       "AMFIUnserializeXML: syntax error near line N" during codesign, which
       names neither the file nor the cause. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
