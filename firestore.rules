rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: authenticated Firebase user only.
    // Domain enforcement happens at token issuance (exchange-code route),
    // so we do not repeat the email regex here — it costs a string match
    // on every rule evaluation and the token was already validated server-side.
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: Check if the authenticated user has the 'admin' group.
    // Uses Custom JWT Claims set in the exchange-code route and refreshed
    // whenever group membership changes — $0 cost, no Firestore read required.
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Helper: Check if the authenticated user has been granted access to a
    // specific page via the page-permissions system. Reads the user's own doc
    // (1 Firestore read) and checks the permittedPageIds array, which is kept
    // up-to-date by recomputeUserPermissions / recomputePermissionsForGroup
    // whenever group membership or page permissions change.
    function hasPagePermission(pageId) {
      // get() returns null for missing docs — guard before chaining .data
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc != null && userDoc.data.get('permittedPageIds', []).hasAny([pageId]);
    }

    // 1. Users collection
    // Client listener: hooks/useUserData.ts (onSnapshot users/{uid})
    // Admin panel reads other users' docs via the listener — needs isAdmin() bypass.
    // Writes: Admin SDK only (API routes bypass these rules)
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    // 1b. Auth email index  (doc id = normalised email → { uid, email })
    // The login allowlist and the only uniqueness constraint on a user's sign-in
    // address. Fully server-side: written by registration and the email
    // migration, read by /api/auth/exchange-code. No client ever touches it, and
    // it must stay that way — a readable index is a staff email directory, and a
    // writable one is an authentication bypass.
    match /auth-emails/{emailKey} {
      allow read, write: if false;
    }

    // 2. Groups collection
    // No client-side listeners; read via API routes (Admin SDK).
    // Keeping a permissive read rule here in case a future client listener
    // needs it, but writes remain server-only.
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // 3. Page permissions collection
    // Client listener: hooks/useAdminData.ts (onSnapshot page-permissions)
    // Full collection read — authenticated users only.
    match /page-permissions/{pageId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // 4. Time entries
    // No client-side listeners currently. All reads/writes go through API routes
    // (Admin SDK). Rules defined here for defence-in-depth and future listeners.
    // Admin access to other users' entries is handled entirely via Admin SDK
    // in API routes, so we do not need an isAdmin() bypass here.
    match /time-entries/{entryId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // 5. Screenshots
    // Same pattern as time-entries.
    match /screenshots/{screenshotId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // 6. Active sessions (new session model)
    // Client-side onSnapshot used by useActiveUsers (admin panel).
    // User reads own doc; admin or any user with shift-management page access reads all.
    // Writes via Admin SDK only.
    match /active_sessions/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin() || hasPagePermission('shift-management'));
      allow list: if isAdmin() || hasPagePermission('shift-management');
      allow write: if false;
    }

    // 7. Time entries ledger (new session model)
    // All reads/writes via Admin SDK (API routes + Cloud Function).
    // User reads own completed sessions; admin reads all.
    match /time_entries/{sessionId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // 8. Notifications
    // Client listener: hooks/useNotifications.tsx (onSnapshot notifications)
    // Users may only read their own notifications. Writes (mark-read, dismiss)
    // go through API routes (Admin SDK) so client write remains denied.
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // 9. Disputes
    // All writes via Admin SDK (API routes — bypass these rules entirely).
    // Users may read disputes they created or are assigned to.
    // Admins may read all disputes.
    match /disputes/{disputeId} {
      allow read: if isSignedIn() && (
        resource.data.createdBy == request.auth.uid ||
        resource.data.assignedTo == request.auth.uid ||
        isAdmin()
      );
      allow write: if false;
    }

    // 10. Shifts
    // All reads/writes via Admin SDK (API routes). No client-side listeners.
    // Rule exists for defence-in-depth — denies any accidental direct client access.
    match /shifts/{shiftId} {
      allow read, write: if false;
    }

    // 11. Creators
    // Creators read their own doc on sign-in (CreatorAuthProvider).
    // All writes via Admin SDK (API routes) — no direct client writes permitted.
    match /creators/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    // 12. Bug reports
    // All writes via Admin SDK (API routes). No client-side access needed.
    // Rule exists for defence-in-depth — denies any accidental direct client writes.
    match /bugs/{bugId} {
      allow read, write: if false;
    }

    // 13. Leave requests
    // All writes via Admin SDK (API routes). Users may read their own leave requests.
    // Admins may read all. No direct client writes permitted.
    match /leave_requests/{leaveId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // 14. Campaign tracking
    // CA agents and managers read all entries; creators read only their own.
    // All writes via Admin SDK (API routes).
    match /campaign-tracking/{entryId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        hasPagePermission('ca-custom-requests') ||
        hasPagePermission('ca-campaigns') ||
        hasPagePermission('creators-custom-requests') ||
        resource.data.creatorID == request.auth.uid
      );
      allow write: if false;
    }

    // 15. Content planning
    // Managers read all entries; creators read only their own.
    // All writes via Admin SDK (API routes).
    match /content-planning/{entryId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        hasPagePermission('creators-content-planning') ||
        resource.data.creatorID == request.auth.uid
      );
      allow write: if false;
    }

    // 16. SMM Twitter/X accounts
    // All reads/writes via Admin SDK (API routes). No client-side listeners.
    match /twitterx-accounts/{accountId} {
      allow read, write: if false;
    }

    // 17. SMM content schedule (posts live in a subcollection; rules do not
    // cascade, so the child match is required for defence-in-depth).
    // All reads/writes via Admin SDK (API routes).
    match /twitterx-content-schedule/{accountId} {
      allow read, write: if false;

      match /posts/{postId} {
        allow read, write: if false;
      }
    }

    // 18. SMM bonus rounds (submissions subcollection — same cascade note).
    // All reads/writes via Admin SDK (API routes).
    match /twitterx-bonus/{roundId} {
      allow read, write: if false;

      match /submissions/{submissionId} {
        allow read, write: if false;
      }
    }

    // 18b. SMM viral-page suggestions (submitted from the Viral Accounts page,
    // reviewed in Bonus Management). All reads/writes via Admin SDK.
    match /twitterx-page-suggestions/{suggestionId} {
      allow read, write: if false;
    }

    // 19. App resources
    // Group/user-filtered reads happen server-side in /api/resources; management
    // writes go through /api/admin/resources. All access via Admin SDK, so no
    // client-side rule is needed — deny everything for defence-in-depth.
    match /app-resources/{resourceId} {
      allow read, write: if false;
    }

    // 20. Analytics rollups
    // analytics_daily holds one precomputed doc per user per local day, written
    // by the rollupDailyAnalytics Cloud Function and read only by
    // /api/admin/analytics/timetracking (which gates on the 'shift-management'
    // page permission). analytics_dirty is the recompute queue.
    // Both are Admin-SDK-only — no client ever touches them directly, so deny
    // everything for defence-in-depth. These docs aggregate the whole company's
    // hours, so a client-readable rule here would be a data leak.
    match /analytics_daily/{docId} {
      allow read, write: if false;
    }

    match /analytics_dirty/{docId} {
      allow read, write: if false;
    }

    // 21. Model submissions (public application form)
    // These documents hold applicants' personal details and links to private
    // photos — the most sensitive data in the project, submitted by people who
    // are not users of this app at all. Every path is Admin-SDK-only:
    //   - writes come from /api/model-submissions/submit (unauthenticated, but
    //     session-token gated and rate limited),
    //   - reads come from /api/model-submissions/admin*, which check the
    //     'apps-model-submissions' page permission first.
    // There is deliberately NO client-readable rule here. A signed-in employee
    // without the page permission must not be able to read these directly, and
    // an applicant must never be able to read anyone's application including
    // their own.
    match /model-submissions/{submissionId} {
      allow read, write: if false;
    }

    // Short-lived form sessions (signing state, per-session file counters, and
    // the pending-photo manifest) plus the per-IP abuse counters. Server-only.
    match /model-submission-sessions/{sessionId} {
      allow read, write: if false;
    }

    match /model-submission-rate/{ipHash} {
      allow read, write: if false;
    }

    // 22. OnlyFans CRM (OF Manager)
    // `onlyfans-chats` is a MIRROR of the third-party provider's chat list, kept
    // fresh by the provider webhook and the sync route. The OF Manager window
    // reads it with onSnapshot — that is what makes the inbox realtime without
    // polling a billed API — so it needs a client-readable rule.
    //
    // Reads are gated on the 'apps-ofmanager' page permission rather than on
    // isSignedIn(): these documents contain fans' names, avatars and message
    // text, and a staff member without the page must not be able to read them
    // straight out of Firestore. Writes are Admin-SDK-only (sync route + webhook).
    match /onlyfans-chats/{chatId} {
      allow read: if hasPagePermission('apps-ofmanager');
      allow write: if false;

      // Live messages only — history is never mirrored (see onlyfansService.ts).
      match /messages/{messageId} {
        allow read: if hasPagePermission('apps-ofmanager');
        allow write: if false;
      }
    }

    // Sync bookkeeping (the chat-list freshness marker). Server-only: no client
    // reads it, and it must not be writable or the provider rate limit is moot.
    match /onlyfans-meta/{accountId} {
      allow read, write: if false;
    }

    // 23. Prompt Library
    // Every read and write goes through /api/prompt-library, which checks the
    // 'apps-prompt-library' page permission (and the admin claim for a hard
    // delete). All access is via the Admin SDK, so deny everything here for
    // defence-in-depth — including the versions subcollection, which is the
    // edit history and must not be client-writable.
    match /prompt-library/{promptId} {
      allow read, write: if false;

      match /versions/{version} {
        allow read, write: if false;
      }
    }

    // The managed category/tag lists behind the library's pickers. Same story.
    match /prompt-library-meta/{docId} {
      allow read, write: if false;
    }

    // 24. Share-token index for the Prompt Library: doc id = the 160-bit share
    // token, body = { promptId }. Read only by the PUBLIC share page, through
    // the Admin SDK, which projects a narrow read-only view of the prompt.
    // Client-readable would let anyone walk the token space; client-writable
    // would let anyone publish any prompt. Deny both.
    match /prompt-shares/{shareId} {
      allow read, write: if false;
    }

    // 25. Device-session index: doc id = a client-minted device id, body =
    // { uid, kind }. The reverse lookup behind per-device session enforcement
    // and behind "is this browser one of ours" on the public share page.
    // It maps an opaque id to a REAL uid, so a client-readable version would
    // turn a leaked device id into an account identifier. Admin SDK only.
    match /device-sessions/{deviceId} {
      allow read, write: if false;
    }

  }
}
