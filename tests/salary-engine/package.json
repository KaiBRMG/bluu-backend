{
  "name": "salary-engine-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Chat-agent salary engine + sales importer unit tests",
  "scripts": {
    "test": "jest --forceExit",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/../../src/$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": false
        }
      ]
    }
  }
}
