{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "jest"
    ],
    "paths": {
      "@/*": [
        "../../src/*"
      ]
    },
    "outDir": "./dist",
    "isolatedModules": true
  },
  "include": [
    "*.ts"
  ]
}
